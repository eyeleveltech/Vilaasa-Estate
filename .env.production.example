# ---------------------------------------------------------------------------
# Vilaasa Estates — production environment (VPS)
#
# TEMPLATE ONLY — safe to commit. Copy to .env.production and fill in real
# values there; .env.production is gitignored.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=production

# --- Database -------------------------------------------------------------
# Credentials for the postgres container. These three must stay consistent
# with the user/password/database embedded in DATABASE_URL below.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=<database-password>
POSTGRES_DB=vilaasa

# The host is the compose SERVICE NAME, not localhost: inside a container,
# "localhost" is the container itself, not the database.
DATABASE_URL=postgresql://postgres:<database-password>@postgres:5432/vilaasa

# --- JWT ------------------------------------------------------------------
JWT_SECRET=<openssl rand -base64 48>
JWT_EXPIRES_IN=7d

# --- Cloudinary -----------------------------------------------------------
CLOUDINARY_CLOUD_NAME=<cloudinary-cloud-name>
CLOUDINARY_API_KEY=<cloudinary-api-key>
CLOUDINARY_API_SECRET=<cloudinary-api-secret>

# --- CORS -----------------------------------------------------------------
# The SPA calls /api/v1 on its own origin, so CORS is not exercised in normal
# use. Both hostnames are listed anyway to cover direct API clients.
ALLOWED_ORIGINS=https://www.vilaasaestates.com,https://vilaasaestates.com

# --- Email (Zoho SMTP) ----------------------------------------------------
SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_USER=info@vilaasaestates.com
SMTP_PASS=<smtp-app-password>
SMTP_FROM="Vilaasa Estates (No-Reply) <info@vilaasaestates.com>"
FROM_NAME="Vilaasa Estates (No-Reply)"
FROM_EMAIL=info@vilaasaestates.com
ADMIN_EMAIL=admin@vilaasaestates.com

# Used to build links inside OTP and notification emails. Must be the public
# site URL, or every emailed link points at localhost.
FRONTEND_URL=https://www.vilaasaestates.com
APP_URL=https://www.vilaasaestates.com

# --- Twilio ---------------------------------------------------------------
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_PHONE_NUMBER=+16402329832
TWILIO_MESSAGING_SERVICE_SID=<twilio-messaging-service-sid>
TWILIO_VERIFY_SERVICE_SID=<twilio-verify-service-sid>
TWILIO_SMS_TEMPLATE="Welcome to Vilaasa Estates. Your private verification code is: {OTP}. Valid for 10 minutes. Please do not share this code."

# --- Destructive seed opt-in ----------------------------------------------
# Leave unset. `npm run db:seed` deletes every row in all 24 tables and
# refuses to run in production unless this equals exactly: wipe-and-reseed
# CONFIRM_DESTRUCTIVE_SEED=
