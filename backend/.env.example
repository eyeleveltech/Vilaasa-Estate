# Server
PORT=5000
NODE_ENV=development

# Database (Neon.tech in production, local PostgreSQL in dev)
DATABASE_URL=postgresql://user:password@localhost:5432/vilaasa_db

# JWT — REQUIRED. Boot aborts if unset or shorter than 32 characters.
# Generate with: openssl rand -base64 48
JWT_SECRET=your_super_secret_jwt_key_min_32_chars
JWT_EXPIRES_IN=7d

# OTP Verification Token
VERIFICATION_TOKEN_SECRET=your_verification_secret_min_32_chars

# Cloudinary — REQUIRED in production (boot aborts if unset).
# In development, uploads are rejected until these are set.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS (comma separated, no spaces)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080,https://vilaasaestates.com

# Email (enable SMTP in Zoho Mail; use an app password when MFA is enabled)
SMTP_HOST=smtp.zoho.com
SMTP_PORT=587
SMTP_USER=your_zoho_mailbox@yourdomain.com
SMTP_PASS=your_zoho_app_password
SMTP_FROM="Vilaasa Estates <your_zoho_mailbox@yourdomain.com>"
ADMIN_EMAIL=admin@vilaasaestates.com
FROM_NAME="Vilaasa Estates Concierge"
FROM_EMAIL=concierge@vilaasaestates.com

# Public site URL — used to build links inside OTP and notification emails
FRONTEND_URL=https://vilaasaestates.com
APP_URL=https://vilaasaestates.com

# Twilio SMS / Verify Service (No phone number required when using Verify Service SID)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_MESSAGING_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_SMS_TEMPLATE=

# Destructive seed opt-in. Leave UNSET.
# `npm run db:seed` deletes every row in all 24 tables. Against
# NODE_ENV=production it refuses to run unless this is set to
# exactly: wipe-and-reseed
# CONFIRM_DESTRUCTIVE_SEED=
