datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// ENUMS
// ----------------------------------------------------

enum Role {
  SUPER_ADMIN
  CHANNEL_PARTNER
  VAULT_CLIENT
}

enum PropertyType {
  RESIDENTIAL_VILLA
  RESIDENTIAL_APARTMENT
  PENTHOUSE
  HERITAGE_ESTATE
  COMMERCIAL
  FRANCHISE
  FARMLAND
}

enum PropertyStatus {
  AVAILABLE
  UNDER_CONSTRUCTION
  OFF_PLAN
  READY_TO_MOVE
  SOLD
  RESERVED
}

enum FurnishingStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
  DESIGNER_FURNISHED
}

enum Currency {
  INR
  AED
  USD
  EUR
  GBP
  SGD
}

enum InquiryStatus {
  NEW
  CONTACTED
  QUALIFIED
  SITE_VISIT_SCHEDULED
  NEGOTIATING
  CLOSED_WON
  CLOSED_LOST
}

enum LeadSource {
  HERO_INQUIRY
  PROPERTY_DETAIL
  FRANCHISE_DETAIL
  SITE_VISIT_MODAL
  CALENDAR_PAGE
  CONTACT_FORM
  CHANNEL_PARTNER_FORM
  VAULT_CONCIERGE
}

enum RentStatus {
  PAID
  OVERDUE
  PENDING
}

enum PaymentMilestoneStatus {
  UPCOMING
  PENDING
  COMPLETED
}

enum ConciergeRequestStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

// ----------------------------------------------------
// USER MODEL (Super Admin & Channel Partner)
// ----------------------------------------------------

model User {
  id            String       @id @default(cuid())
  email         String       @unique
  passwordHash  String
  name          String
  phone         String?
  phoneCode     String?      @default("+91")
  role          Role         @default(CHANNEL_PARTNER)
  avatar        String?
  licenseNumber String?      // Broker License Number / RERA Agent No.
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  assignedProperties Property[]         @relation("AdminProperties")
  assignedInquiries  Inquiry[]          @relation("AssignedInquiries")
  vaultAssets        VaultAsset[]
  vaultDocuments     VaultDocument[]
  conciergeRequests  ConciergeRequest[]
  nominees           Nominee[]
  legacyDocuments    LegacyDocument[]

  @@index([role, isActive])
  @@index([email])
}

// ----------------------------------------------------
// PROPERTY MODEL
// ----------------------------------------------------

model Property {
  id                  String           @id @default(cuid())
  slug                String           @unique
  name                String
  tagline             String?
  description         String           @db.Text
  visionHeadline      String?
  type                PropertyType     @default(RESIDENTIAL_VILLA)
  customType          String?
  status              PropertyStatus   @default(AVAILABLE)
  isDeleted           Boolean          @default(false)
  views               Int              @default(0)

  // Pricing
  price               Decimal          @db.Decimal(15, 2)
  currency            Currency         @default(INR)
  priceOnApplication  Boolean          @default(false)

  // Financial Estimates & Projections
  rentalYieldPercent  Decimal?         @db.Decimal(5, 2)
  expectedIrrPercent  Decimal?         @db.Decimal(5, 2)
  appreciationPercent Decimal?         @db.Decimal(5, 2)

  // Specifications
  totalAreaSqFt       Float?
  bedrooms            Int?
  bathrooms           Int?
  furnishingStatus    FurnishingStatus @default(FULLY_FURNISHED)
  possessionDate      DateTime?
  reraNumber          String?          // Dubai Trakheesi Permit / India RERA Reg No.
  ownershipType       String?          // "Freehold" | "Leasehold"
  paymentPlan         Json?            // Structured payment breakdown { milestones: [] }
  virtualTour360Url   String?
  brochureUrl         String?          // Direct PDF Brochure URL (e.g. Cloudinary PDF link)
  maintenanceFeePerSqFt Decimal?       @db.Decimal(10, 2)
  customSpecs         Json?            // User-defined free-text specifications [{ label: string, value: string }]
  sectionVisibility   Json?            // Controls public display of sections { "sec-specs": true, ... }

  // Editorial Verdict
  verdictQuote        String?          @db.Text
  verdictAuthor       String?
  verdictTitle        String?

  // Franchise-specific fields (only used when type = FRANCHISE)
  franchiseModel        String?   // "FOCO" | "FOFO" | "FICO"
  minTicketSize         Decimal?  @db.Decimal(15, 2)
  totalProjectCost      Decimal?  @db.Decimal(15, 2)
  paybackPeriodYears    Float?    // e.g. 3.5
  lockInPeriodYears     Float?    // e.g. 2.0
  expectedAnnualRoi     Float?    // e.g. 24.0 (percent)
  yieldPayoutFrequency  String?   // "MONTHLY" | "QUARTERLY" | "ANNUALLY"
  supportModules        Json?     // ["Location Scouting", "Operator Certification", ...]
  advantages            Json?     // ["Low capex", "Proven brand", ...]

  // Relations
  locationId          String
  location            Location         @relation(fields: [locationId], references: [id], onDelete: Restrict)

  adminId             String?
  admin               User?            @relation("AdminProperties", fields: [adminId], references: [id], onDelete: SetNull)

  configurations      PropertyConfiguration[]
  media               PropertyMedia[]
  amenities           PropertyOnAmenity[]
  nearbyPlaces        NearbyPlace[]
  financialMetrics    PropertyFinancialMetric[]
  constructionAsset   ConstructionAsset?
  inquiries           Inquiry[]
  siteVisits          SiteVisit[]
  vaultAssets         VaultAsset[]
  conciergeRequests   ConciergeRequest[]
  franchisePage       FranchisePage?

  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  @@index([isDeleted, status, type])
  @@index([locationId])
  @@index([price])
}

// ----------------------------------------------------
// LOCATION MODEL
// ----------------------------------------------------

model Location {
  id           String     @id @default(cuid())
  city         String     // e.g. "Dubai", "Hyderabad", "Goa", "Mumbai"
  country      String     // e.g. "UAE", "India", "UK", "USA"
  community    String?    // e.g. "Palm Jumeirah", "Downtown Dubai", "Bandra"
  addressLine  String?
  postalCode   String?
  latitude     Float?
  longitude    Float?
  googleMapUrl String?
  mapEmbedUrl  String?

  properties   Property[]

  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([country, city])
}

// ----------------------------------------------------
// PROPERTY CONFIGURATIONS / UNITS
// ----------------------------------------------------

model PropertyConfiguration {
  id           String   @id @default(cuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  unitType     String   // e.g. "3 BHK Presidential Suite", "4 BHK Penthouse"
  areaSqFt     Float
  viewType     String?  // e.g. "Arabian Gulf Sea View", "Golf Course View"
  price        Decimal  @db.Decimal(15, 2)
  isAvailable  Boolean  @default(true)
  floorPlanUrl String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([propertyId])
}

// ----------------------------------------------------
// MEDIA (Cloudinary Assets)
// ----------------------------------------------------

model PropertyMedia {
  id           String   @id @default(cuid())
  propertyId   String
  property     Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  mediaType    String   // "HERO_IMAGE" | "GALLERY" | "BROCHURE_PDF" | "VIDEO_MP4" | "TOUR_360" | "FLOOR_PLAN"
  url          String
  thumbnailUrl String?
  altText      String?
  orderIndex   Int      @default(0)
  isFeatured   Boolean  @default(false)

  createdAt    DateTime @default(now())

  @@index([propertyId, mediaType])
  @@index([propertyId, isFeatured])
}

// ----------------------------------------------------
// AMENITY CATALOG & M2M RELATION
// ----------------------------------------------------

model Amenity {
  id         String              @id @default(cuid())
  name       String              @unique // e.g. "Private Infinity Pool"
  iconKey    String              // Material Symbols icon name
  category   String?             // "Wellness", "Security", "Sports", "Lifestyle"

  properties PropertyOnAmenity[]
}

model PropertyOnAmenity {
  propertyId  String
  amenityId   String
  description String?           // Custom property-specific amenity description

  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  amenity     Amenity  @relation(fields: [amenityId], references: [id], onDelete: Cascade)

  @@id([propertyId, amenityId])
  @@index([amenityId])
}

// ----------------------------------------------------
// NEARBY PLACES / CONNECTIVITY
// ----------------------------------------------------

model NearbyPlace {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name       String   // "Dubai International Airport"
  distance   String   // "15 Mins Drive"
  category   String?  // "Airport", "Metro", "School", "Hospital", "Shopping"
  travelTime String?
  description String? @db.Text
  iconKey    String?

  @@index([propertyId])
}

// ----------------------------------------------------
// FINANCIAL METRICS
// ----------------------------------------------------

model PropertyFinancialMetric {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  label      String   // "Projected Net Yield", "5-Year Capital Gain"
  value      String   // "6.5% p.a.", "₹8.2 Cr"
  note       String?
  icon       String?  // Material icon identifier

  @@index([propertyId])
}

// ----------------------------------------------------
// CONSTRUCTION ASSET & MILESTONES
// ----------------------------------------------------

model ConstructionAsset {
  id                String                    @id @default(cuid())
  propertyId        String                    @unique
  property          Property                  @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  structureProgress Int                       @default(0)
  interiorProgress  Int                       @default(0)
  overallProgress   Int                       @default(0)
  lastUpdate        DateTime                  @default(now())

  milestones        ConstructionMilestone[]
  gallery           ConstructionGalleryItem[]

  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
}

model ConstructionMilestone {
  id                  String            @id @default(cuid())
  constructionAssetId String
  constructionAsset   ConstructionAsset @relation(fields: [constructionAssetId], references: [id], onDelete: Cascade)

  name                String            // "Foundation & Piling", "Superstructure"
  status              String            // "COMPLETED" | "IN_PROGRESS" | "UPCOMING"
  targetDate          DateTime

  @@index([constructionAssetId])
}

model ConstructionGalleryItem {
  id                  String            @id @default(cuid())
  constructionAssetId String
  constructionAsset   ConstructionAsset @relation(fields: [constructionAssetId], references: [id], onDelete: Cascade)

  imageUrl            String
  date                DateTime
  caption             String?

  @@index([constructionAssetId])
}

// ----------------------------------------------------
// OTP RECORDS (Vault Login & Client Auth)
// ----------------------------------------------------

model OtpRecord {
  id        String   @id @default(cuid())
  email     String?
  phone     String?
  channel   String   @default("EMAIL") // "EMAIL" | "SMS"
  otp       String
  expiresAt DateTime
  verified  Boolean  @default(false)
  attempts  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([email])
  @@index([phone])
}

// ----------------------------------------------------
// INQUIRIES & LEAD MANAGEMENT
// ----------------------------------------------------

model Inquiry {
  id              String        @id @default(cuid())
  name            String
  email           String
  phone           String
  investmentType  String        // "real-estate" | "franchise"
  investmentRange String
  currency        Currency      @default(INR)
  status          InquiryStatus @default(NEW)
  source          LeadSource    @default(HERO_INQUIRY)
  notes           String?       @db.Text
  utmSource       String?
  utmMedium       String?
  utmCampaign     String?
  followUpDate    DateTime?
  followUpNotes   String?       @db.Text

  propertyId      String?
  property        Property?     @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  assignedAgentId String?
  assignedAgent   User?         @relation("AssignedInquiries", fields: [assignedAgentId], references: [id], onDelete: SetNull)

  timeline        InquiryTimeline[]

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([status, propertyId])
  @@index([email])
  @@index([followUpDate])
}

model InquiryTimeline {
  id          String   @id @default(cuid())
  inquiryId   String
  inquiry     Inquiry  @relation(fields: [inquiryId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  note        String?  @db.Text
  changedById String?
  createdAt   DateTime @default(now())

  @@index([inquiryId])
}

// ----------------------------------------------------
// CHANNEL PARTNER DIRECTORY
// ----------------------------------------------------

model ChannelPartner {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  phone        String
  company      String?
  experience   String?
  city         String?
  status       String   @default("PENDING") // "PENDING" | "APPROVED" | "REJECTED"
  approvedById String?
  userId       String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([status])
}

// ----------------------------------------------------
// SITE VISITS
// ----------------------------------------------------

model SiteVisit {
  id            String   @id @default(cuid())
  propertyId    String
  property      Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  name          String
  email         String
  phone         String
  scheduledDate DateTime
  scheduledTime String   // e.g. "11:00 AM"
  timezone      String   @default("Asia/Kolkata")
  visitType     String   // "real-estate-india" | "real-estate-international"
  status        String   @default("CONFIRMED")
  notes         String?

  createdAt     DateTime @default(now())

  @@index([propertyId, scheduledDate])
}

// ----------------------------------------------------
// THE VAULT (Investor Portfolios)
// ----------------------------------------------------

model VaultAsset {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  propertyId         String
  property           Property @relation(fields: [propertyId], references: [id], onDelete: Restrict)

  unitNumber         String
  purchaseDate       DateTime
  purchasePrice      Decimal  @db.Decimal(15, 2)
  currentValuation   Decimal  @db.Decimal(15, 2)
  monthlyRentalYield Decimal? @db.Decimal(15, 2)
  occupancyStatus    String   @default("OCCUPIED")

  leases             Lease[]
  paymentMilestones  PaymentMilestone[]
  documents          VaultDocument[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([userId])
  @@index([propertyId])
}

// ----------------------------------------------------
// THE VAULT: LEASES & TENANCY
// ----------------------------------------------------

model Lease {
  id           String      @id @default(cuid())
  vaultAssetId String
  vaultAsset   VaultAsset  @relation(fields: [vaultAssetId], references: [id], onDelete: Cascade)

  tenantName   String
  leaseStart   DateTime
  leaseExpiry  DateTime
  monthlyRent  Decimal     @db.Decimal(15, 2)
  rentStatus   RentStatus  @default(PAID)
  lastPayment  DateTime?

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([vaultAssetId])
}

// ----------------------------------------------------
// THE VAULT: PAYMENT MILESTONES
// ----------------------------------------------------

model PaymentMilestone {
  id           String                 @id @default(cuid())
  vaultAssetId String
  vaultAsset   VaultAsset             @relation(fields: [vaultAssetId], references: [id], onDelete: Cascade)

  name         String
  amount       Decimal                @db.Decimal(15, 2)
  dueDate      DateTime
  status       PaymentMilestoneStatus @default(UPCOMING)
  paidAmount   Decimal?               @db.Decimal(15, 2)

  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt

  @@index([vaultAssetId])
}

// ----------------------------------------------------
// THE VAULT: SECURE DOCUMENT REPOSITORY
// ----------------------------------------------------

model VaultDocument {
  id           String      @id @default(cuid())
  userId       String
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  vaultAssetId String?
  vaultAsset   VaultAsset? @relation(fields: [vaultAssetId], references: [id], onDelete: SetNull)

  name         String
  type         String      // "Ownership Documents" | "Financial Reports" | "Tax & Legal" | "Floor Plans" | "Brochures"
  fileUrl      String
  sizeLabel    String?     // e.g. "2.4 MB"
  iconKey      String?     // e.g. "description", "receipt_long", "gavel"

  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([userId])
  @@index([vaultAssetId])
}

// ----------------------------------------------------
// THE VAULT: CONCIERGE SERVICE REQUESTS
// ----------------------------------------------------

model ConciergeRequest {
  id          String                 @id @default(cuid())
  userId      String
  user        User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  propertyId  String?
  property    Property?              @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  type        String                 // "resale" | "visit" | "maintenance" | "tax" | "legal" | "other"
  description String                 @db.Text
  status      ConciergeRequestStatus @default(PENDING)

  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([userId])
  @@index([propertyId])
}

// ----------------------------------------------------
// THE VAULT: NOMINEE & SUCCESSION
// ----------------------------------------------------

model Nominee {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name         String
  relationship String
  email        String?
  phone        String?
  share        Int      @default(100)
  isPrimary    Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------
// THE VAULT: LEGACY & ESTATE DOCUMENTS
// ----------------------------------------------------

model LegacyDocument {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  name       String
  type       String   // "Will" | "Trust" | "Power of Attorney" | "Healthcare Directive"
  fileUrl    String
  uploadedAt DateTime @default(now())

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

// ----------------------------------------------------
// HOMEPAGE HERO HIGHLIGHTS (UP TO 3 SPOTLIGHTS)
// ----------------------------------------------------

model HeroHighlight {
  id        String   @id @default(cuid())
  name      String   // e.g. "Carlton", "Oxygen Forest"
  tagline   String   // e.g. "Luxury Experiences • Andhra Pradesh"
  linkUrl   String   // e.g. "/property/carlton" or "/franchise/carlton-spa"
  icon      String   @default("hotel_class")
  order     Int      @default(1)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

// ----------------------------------------------------
// FRANCHISE PAGE CONTENT (Bespoke Editorial & Layouts)
// ----------------------------------------------------

model FranchisePage {
  id                   String   @id @default(cuid())
  propertyId           String   @unique
  property             Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  // 1. Hero Section
  pageTitle            String?
  mainHeadline         String?
  subheading           String?  @db.Text
  heroImage            String?

  // Dynamic Badges & Cards (Json arrays)
  heroMetrics          Json?
  blueprintMetrics     Json?
  ecosystemCards       Json?
  benefitCards         Json?
  sectionVisibility    Json?

  // 2. Hero Financial Metrics (Free Text Pairs)
  metric1Label         String?
  metric1Value         String?
  metric2Label         String?
  metric2Value         String?
  metric3Label         String?
  metric3Value         String?
  metric4Label         String?
  metric4Value         String?

  // 3. The Vision Section
  visionHeadline       String?
  visionDescription    String?  @db.Text

  // 4. Stats Row
  stat1Label           String?
  stat1Value           String?
  stat2Label           String?
  stat2Value           String?
  stat3Label           String?
  stat3Value           String?

  // 5. Financial Blueprint (Deep Metrics - Free Text)
  metric5Label         String?
  metric5Value         String?
  metric6Label         String?
  metric6Value         String?
  metric7Label         String?
  metric7Value         String?
  metric8Label         String?
  metric8Value         String?

  // 6. Financial Planning
  planningHeadline     String?
  planningDescription  String?  @db.Text
  ctaButton1           String?

  // 7. Comprehensive Ecosystem (Support & Training)
  ecosystemSubheading  String?  @default("Comprehensive Ecosystem")
  ecosystemHeading     String?  @default("Support & Training")
  ecosystemDescription String?  @db.Text

  support1Title        String?
  support1Description  String?  @db.Text
  support1Icon         String?  @default("storefront")
  support2Title        String?
  support2Description  String?  @db.Text
  support2Icon         String?  @default("design_services")
  support3Title        String?
  support3Description  String?  @db.Text
  support3Icon         String?  @default("school")
  support4Title        String?
  support4Description  String?  @db.Text
  support4Icon         String?  @default("campaign")

  // 8. Key Benefits (The FOCO Advantage)
  benefitsSubheading   String?  @default("The FOCO Advantage")
  benefitsDescription  String?  @db.Text

  benefit1Title        String?
  benefit1Description  String?  @db.Text
  benefit1Icon         String?  @default("volunteer_activism")
  benefit2Title        String?
  benefit2Description  String?  @db.Text
  benefit2Icon         String?  @default("shield")
  benefit3Title        String?
  benefit3Description  String?  @db.Text
  benefit3Icon         String?  @default("trending_up")

  // 9. Next Steps
  nextStepsSubheading  String?
  nextStepsDescription String?  @db.Text
  ctaButton2           String?

  // 10. Gallery Images (Property Creation Gallery Style)
  galleryImages        Json?

  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([propertyId])
}

